@startuml
' MPV-STYLE-BEGIN
skinparam defaultFontName "Microsoft YaHei"
skinparam monospacedFontName "Consolas"
skinparam backgroundColor #FBFBFD
skinparam shadowing true
skinparam roundCorner 10
skinparam linetype ortho
skinparam dpi 180
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam ArrowColor #5B6B7C
skinparam ArrowThickness 1.1
skinparam ArrowFontSize 11
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #3D5A80
skinparam ClassBorderThickness 1.2
skinparam ClassFontColor #1B2A3A
skinparam ClassFontSize 14
skinparam ClassFontStyle bold
skinparam ClassAttributeFontColor #33475B
skinparam ClassAttributeFontSize 12
skinparam ClassStereotypeFontSize 12
skinparam PackageBackgroundColor #F4F7FB
skinparam PackageBorderColor #9FB3C8
skinparam PackageBorderThickness 1.2
skinparam PackageFontColor #293845
skinparam PackageFontSize 13
skinparam PackageFontStyle bold
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #D9A441
skinparam NoteFontColor #4A3B12
skinparam TitleFontSize 18
skinparam TitleFontColor #1B2A3A
skinparam TitleFontStyle bold
skinparam TitleBorderThickness 0
skinparam HeaderFontSize 11
skinparam HeaderFontColor #7A8B99
skinparam FooterFontSize 10
skinparam FooterFontColor #9AA7B3
hide empty members
hide circle
' MPV-STYLE-END
title scanner/report.py 类图
class "scanner/report.py\n<<线性脚本，无函数/类定义>>" as S << (S,#CFD8DC) >> {
  扫描结果统计报告（模式/严重性/隐藏行为分布）
}
note bottom of S : 该文件为从上到下顺序执行的脚本，\n详细步骤见同目录流程图 report_flow.puml
@enduml
