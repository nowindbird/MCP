@startuml
' MPV-STYLE-BEGIN
skinparam defaultFontName "Microsoft YaHei"
skinparam monospacedFontName "Consolas"
skinparam backgroundColor #FBFBFD
skinparam shadowing true
skinparam roundCorner 12
skinparam linetype ortho
skinparam dpi 180
skinparam ArrowColor #546E7A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 11
skinparam ActivityBackgroundColor #DCEEFB
skinparam ActivityBorderColor #2E6DA4
skinparam ActivityBorderThickness 1.2
skinparam ActivityFontColor #123A5A
skinparam ActivityFontSize 13
skinparam ActivityDiamondBackgroundColor #FFE8CC
skinparam ActivityDiamondBorderColor #D9761B
skinparam ActivityDiamondBorderThickness 1.2
skinparam ActivityDiamondFontColor #7A3E00
skinparam ActivityDiamondFontSize 12
skinparam ActivityStartColor #2E7D32
skinparam ActivityEndColor #C62828
skinparam ActivityBarColor #546E7A
skinparam ActivityArrowColor #546E7A
skinparam PartitionBorderColor #9FB3C8
skinparam PartitionBorderThickness 1.2
skinparam PartitionBackgroundColor #F4F7FB
skinparam PartitionFontColor #293845
skinparam PartitionFontSize 13
skinparam PartitionFontStyle bold
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #D9A441
skinparam NoteFontColor #4A3B12
skinparam TitleFontSize 18
skinparam TitleFontColor #1B2A3A
skinparam TitleFontStyle bold
skinparam TitleBorderThickness 0
skinparam HeaderFontSize 11
skinparam HeaderFontColor #7A8B99
skinparam FooterFontSize 10
skinparam FooterFontColor #9AA7B3
' MPV-STYLE-END
title extract_claims()  声明原子化
header
  detector/analyzer/align_rate.py · Step 2
endheader
start
if (文本为空?) then (是)
  :返回 [];
  stop
endif
while (还有行?) is (是)
  :行 strip 去空白;
  if (长度 < 6 或 > 500?) then (是)
    :跳过;
  else (否)
    if (整行是纯标点/链接/代码块标记?) then (是)
      :跳过（正则 ^[\s\-*#>!\]\[|]+$）;
    else (否)
      while (遍历五类 SECURITY_KEYWORDS?) is (是)
        if (该行命中某类关键词?) then (是)
          :记一条声明\n{category, claim, evidence}\n一行只归一个类别;
          break
        endif
      endwhile (否)
    endif
  endif
endwhile (否)
:返回 claims 列表;
stop
@enduml
