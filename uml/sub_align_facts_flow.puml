title 硬事实收集  extract_python_facts / js / go / rust
header
  detector/analyzer/align_rate.py · Step 1
endheader
start
partition "Python（AST 精确）" {
  :遍历 .py 文件，ast.parse 成语法树;
  :遍历 Call 节点，按函数名/模块\n归入五类安全行为;
  :记录 file:line 与调用片段;
}
partition "JS / Go / Rust（正则）" {
  :_extract_regex_facts 按语言正则\n扫描 net/http、fetch、os/exec 等;
}
:四类结果按五类合并\n（file_access / network / subprocess /\ncredential / obfuscation）;
:sorted(set(...)) 去重;
:每类截断到前 200 条;
:has_hard_facts = 任一类非空;
stop
@enduml
