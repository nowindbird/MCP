title run_fixture()  离线样本回放
header
  detector/executor/behavior_monitor.py
endheader
start
:new MonitorReport(rules)，start();
if (strace 文件存在?) then (是)
  :读取 strace 文本（utf-8-sig, replace）;
endif
if (网络抓包文件存在?) then (是)
  :读取 tcpdump 文本;
endif
:取 rules.blocklist.honeypot_indicators\n作为蜜罐判定依据;
:parse_event_log(strace, net,\nhoneypot_indicators,\nnoise_prefixes,\nsensitive_patterns);
while (还有解析出的行为?) is (是)
  :report.add_behavior(behavior)\n内部触发规则匹配与计数;
endwhile (否)
:report.stop()，返回报告;
stop
@enduml
